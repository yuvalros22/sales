generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   // "admin", "agent", "customer"
  createdAt DateTime @default(now())
  orders    Order[]
}

model BaseItem {
  itemCode    String  @id
  itemName    String
  packageSize Int     @default(1)
  imageUrl    String?
}

model InventoryItem {
  id          String   @id @default(cuid())
  itemCode    String
  itemName    String
  modelCode   String
  modelName   String
  quality     String
  bloomPct    String
  quantity    Float
  updatedAt   DateTime @default(now())

  @@unique([itemCode, modelCode, quality, bloomPct])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  customerName    String?
  cartNumber      String?
  orderNumber     String?
  lineNumber      String?
  prodOrderNumber String?
  prodLineNumber  String?
  status          String      @default("pending")
  deliveryDate    DateTime?   // [NEW] תאריך יעד לקבלה
  isEntered       Boolean     @default(false) // [NEW] האם הוקלד למעלה
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemCode    String
  itemName    String
  modelCode   String
  modelName   String
  quality     String
  bloomPct    String
  packages    Int
  units       Int
  packageSize Int
}
